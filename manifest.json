{
  "manifest_version": 3,
  "name": "TranslateFlow: AI Web & Inline Translator",
  "version": "1.0.0",
  "description": "Instant, developer-friendly inline web translation powered by Chrome Built-in AI. Preserves code, APIs, and technical terms.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "TranslateFlow"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/term-guardian.js",
        "content/translator-engine.js",
        "content/ui-popover.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
